# Jenkins API - Libertya Core publico.
# Copiar a .env y completar con datos del Jenkins publico.
# No copiar credenciales ni URL del ambiente libertya-core-teh.

JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

JENKINS_MULTIBRANCH_JOB=Libertya-Core-Multibranch
JENKINS_JDK_NAME=java-11-openjdk-amd64
JENKINS_TEST_JDK_NAME=java-8
GIT_REPOSITORY_URL=https://github.com/Disytel-Consulting-SA/libertya.git
LOCAL_RELEASES_DIR=/home/developers/releases/libertya-core
LOCAL_RELEASES_TO_KEEP=10
