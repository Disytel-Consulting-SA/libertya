[Unit]
Description=Libertya Application Server (JBoss)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=libertya
Group=libertya
WorkingDirectory=/ServidorOXP/utils
Environment=OXP_HOME=/ServidorOXP
EnvironmentFile=-/etc/sysconfig/libertyad
EnvironmentFile=-/etc/default/libertyad

# Inicia en foreground para que systemd controle el proceso real.
ExecStart=/bin/bash -lc 'exec ./IniciarServidor.sh'

# Intenta shutdown limpio por script (el -S se ignoraba en el script actual).
ExecStop=/bin/bash -lc './DetenerServidor.sh'

Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
SuccessExitStatus=143
UMask=0027
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=multi-user.target
