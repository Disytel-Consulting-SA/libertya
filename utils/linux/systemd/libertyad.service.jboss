[Unit]
Description=Libertya Application Server 3
After=network.target

[Service]
Type=simple
User=libertya
Group=libertya
WorkingDirectory=/ServidorOXP

Environment=JAVA_HOME=/opt/jdk-11.0.24+8
Environment=OXP_HOME=/ServidorOXP

RuntimeDirectory=libertya
RuntimeDirectoryMode=0755

ExecStart=/bin/bash -lc '/ServidorOXP/utils/IniciarServidorJBoss.sh & sleep 1; exit 0'
ExecStop=/bin/bash  -lc '/ServidorOXP/utils/DetenerServidorJBoss.sh -S'

RemainAfterExit=yes
TimeoutStartSec=3min
TimeoutStopSec=45s
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
